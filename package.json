{
  "name": "agro-painel",
  "version": "1.0.0",
  "type": "module",
  "description": "Painel administrativo para gestão de planos, análise de lavouras e grupos de comparação de safra.",
  "scripts": {
    "ng": "ng",
    "postinstall": "npm install --prefix backend --no-fund --no-audit",
    "start": "ng serve",
    "start:api": "ng serve --configuration api",
    "api": "npm --prefix backend run dev",
    "build": "ng build",
    "build:demo": "ng build --configuration demo",
    "serve:prod": "npm run build && npm --prefix backend start",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:api": "npm --prefix backend test",
    "cy:open": "node scripts/cypress.mjs open --e2e --browser chrome",
    "cy:run": "node scripts/cypress.mjs run --e2e --browser chrome",
    "cy:run:server": "node scripts/cypress.mjs run --e2e --browser chrome --config baseUrl=http://localhost:3000 --expose API_MODE=server",
    "e2e": "start-server-and-test start http://localhost:4200 cy:run",
    "e2e:open": "start-server-and-test start http://localhost:4200 cy:open",
    "e2e:server": "npm run build && start-server-and-test \"npm --prefix backend start\" http://localhost:3000/api/v1/health cy:run:server",
    "format": "prettier --write \"src/**/*.{ts,html,css}\""
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "cypress": "^16.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "start-server-and-test": "^3.0.13",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
